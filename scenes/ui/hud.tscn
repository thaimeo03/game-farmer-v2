[node name="Help" type="Label" parent="Root"]
layout_mode = 1
anchors_preset = -1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -420.0
offset_top = 12.0
offset_right = -12.0
offset_bottom = 110.0
grow_horizontal = 0
theme_override_colors/font_outline_color = Color(1, 1, 1, 1)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 14
text = "WASD: đi | Shift: chạy | E/Space/Click: tương tác
1-5: công cụ (bấm 3 lần nữa để đổi hạt)
I/Tab: túi đồ | O: tủ đồ | J: sổ cá | Esc: đóng
L: nhiệm vụ & hàng xóm | G: biểu cảm
Chuột phải: xoay camera | Lăn chuột: zoom"
horizontal_alignment = 2

