; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Farmer"
run/main_scene="res://scenes/main/main.tscn"
config/auto_accept_quit=true
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Database="*res://scripts/managers/database.gd"
GameState="*res://scripts/managers/game_state.gd"
Progression="*res://scripts/managers/progression.gd"
SaveManager="*res://scripts/managers/save_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":32), Object(InputEventMouseButton,"button_index":1,"pressed":true)]
}
inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":73), Object(InputEventKey,"physical_keycode":4194306)]
}
tool_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
tool_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
tool_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
tool_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="camera_blocker"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
