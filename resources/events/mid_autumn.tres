[resource]
script = ExtResource("1")
id = &"mid_autumn"
title = "Tết Trung Thu"
letter = "Lễ hội Trăng Rằm đã bắt đầu! Phố Chợ và Công Viên treo đèn lồng, có gian hàng bánh trung thu và đèn ông sao. Ghé chơi và tặng bánh cho hàng xóm nhé!"
first_day = 13
last_day = 17
zones = Array[StringName]([&"market_town", &"fun_park"])
stall_title = "Gian hàng Trung Thu"
stock = Array[ExtResource("6")]([ExtResource("2"), ExtResource("3")])
decor = ExtResource("4")
quest = ExtResource("5")
