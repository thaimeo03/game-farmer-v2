[resource]
script = ExtResource("1")
id = &"co_lan"
display_name = "Cô Lan"
title = "Đầu bếp"
base_id = "character-female-c"
outfits = Array[ExtResource("os")]([ExtResource("o0")])
likes = Array[StringName]([&"tomato", &"milk", &"egg", &"mooncake"])
dislikes = Array[StringName]([&"trash_bones", &"trash_bottle"])
schedule = PackedStringArray("7 market_town Market", "12 fun_park Parasol0", "15 market_town Market", "20 home")
lines = Array[String](["Cà chua chín mọng là nấu canh ngon nhất.", "Hôm nay chợ đông quá trời!"])
lines_friend = Array[String](["Lần sau cô dạy con làm bánh bí ngô nha.", "Có trứng tươi thì cho cô xin vài quả nhé."])
lines_close = Array[String](["Con như người nhà rồi, ghé cô ăn cơm đi.", "Cô để dành phần ngon nhất cho con đó."])
quest = ExtResource("q")
