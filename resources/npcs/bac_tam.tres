lines = Array[String](["Đất có tốt thì cây mới tươi, nhớ tưới đều nhé.", "Hạt bí ngô dễ trồng mà bán được giá lắm!"])
lines_friend = Array[String](["Cháu chăm ruộng giỏi ghê, bác nhìn là biết.", "Mưa xuống là bác khỏi phải tưới, khỏe re!"])
lines_close = Array[String](["Có cháu làm hàng xóm, bác vui lắm.", "Bí quyết của bác: bón phân trước khi tưới."])
quest = ExtResource("q")
