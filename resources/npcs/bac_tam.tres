[resource]
script = ExtResource("1")
id = &"bac_tam"
display_name = "Bác Tâm"
title = "Lão nông"
base_id = "character-male-c"
outfits = Array[ExtResource("os")]([ExtResource("o0")])
likes = Array[StringName]([&"pumpkin", &"mooncake", &"fertilizer"])
dislikes = Array[StringName]([&"trash_bottle", &"trash_can"])
