lines_friend = Array[String](["Cháu gửi quà cho hàng xóm thì cứ ra bưu điện.", "Ông đi khắp làng, chuyện gì cũng biết!"])
lines_close = Array[String](["Ông coi cháu như cháu ruột vậy.", "Cảm ơn cháu đã hay hỏi thăm ông già này."])
quest = ExtResource("q")
