[resource]
script = ExtResource("1")
id = &"ong_bay"
display_name = "Ông Bảy"
title = "Bưu tá"
base_id = "character-male-g"
outfits = Array[ExtResource("os")]([ExtResource("o0")])
likes = Array[StringName]([&"pumpkin_pie", &"mushroom_soup", &"mooncake"])
dislikes = Array[StringName]([&"trash_can", &"fish_perch"])
